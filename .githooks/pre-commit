#!/bin/sh
# Keeps the engine's recorded fingerprint (plugins/job-search/engine/jobkit/__init__.py) in step with
# its files, so tests/test_guards.py passes and users' copies of the engine are refreshed. Turn it on
# once per clone:  git config core.hooksPath .githooks
# It hashes the files as they are on disk, so stage engine changes whole.
if git diff --cached --name-only | grep -q '^plugins/job-search/engine/'; then
  PY=python3
  python3 -c 'import sys' >/dev/null 2>&1 || PY=python  # on Windows, python3 can be a shortcut that runs nothing
  "$PY" tools/update_fingerprint.py >/dev/null || exit 1
  git add plugins/job-search/engine/jobkit/__init__.py
fi
